      "topLeftX": 81,
      "topLeftY": 248,
      "bottomRightX": 636,
      "bottomRightY": 283,
      "content": "The following example shows how to use this mechanism for indirect addressing (see also Figure 13):",
      "confidenceScores": null,
      "type": "text"
    },
    {
      "topLeftX": 115,
      "topLeftY": 296,
      "bottomRightX": 393,
      "bottomRightY": 611,
      "content": "<Integer Name=\"BaseAddress\">\n    <Value>0xff00</Value>\n</Integer>\n\n<IntReg Name=\"Gain\">\n    <Address>0x04</Address>\n    <pAddress>BaseAddress</pAddress>\n    <Length>4</Length>\n    <AccessMode>RW</AccessMode>\n    <pPort>Device</pPort>\n    <Sign>Unsigned</Sign>\n    <Endianess>LittleEndian</Endianess>\n</IntReg>\n\n<IntReg Name=\"Offset\">\n    <Address>0x08</Address>\n    <pAddress>BaseAddress</pAddress>\n    <Length>4</Length>\n    <AccessMode>RW</AccessMode>\n    <pPort>Device</pPort>\n    <Sign>Unsigned</Sign>\n    <Endianess>LittleEndian</Endianess>\n</IntReg>",
      "confidenceScores": null,
      "type": "code"
    },
    {
      "topLeftX": 82,
      "topLeftY": 619,
      "bottomRightX": 374,
      "bottomRightY": 636,
      "content": "This example mimics a C/C++ struct of the form:",
      "confidenceScores": null,
      "type": "text"
    },
    {
      "topLeftX": 99,
      "topLeftY": 647,
      "bottomRightX": 427,
      "bottomRightY": 716,
      "content": "struct { // BaseAddress 0xff00\n    uint32_t Reserved;\n    uint32_t Gain; // Offset 0x04\n    uint32_t Offset; // Offset 0x08\n};",
      "confidenceScores": null,
      "type": "code"
    },
    {
