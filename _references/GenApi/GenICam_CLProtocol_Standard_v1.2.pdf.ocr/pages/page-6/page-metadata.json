    },
    {
      "topLeftX": 81,
      "topLeftY": 719,
      "bottomRightX": 635,
      "bottomRightY": 749,
      "content": "A VendorC however might not bother with automatic identification altogether and just enumerates all camera models the driver library can deal with:",
