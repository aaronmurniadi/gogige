#!/usr/bin/env bash
# gofmt the whole project + run unit tests before allowing a commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

export CGO_ENABLED="${CGO_ENABLED:-0}"

# Every Go file in the tree (tracked + new, ignoring build artifacts).
mapfile -t go_files < <(git ls-files -co --exclude-standard -- '*.go')
if [[ ${#go_files[@]} -gt 0 ]]; then
	# Stage exactly the files gofmt would change so the commit carries only
	# the formatting fix, not unrelated working-tree edits.
	mapfile -t changed < <(gofmt -l "${go_files[@]}")
	if [[ ${#changed[@]} -gt 0 ]]; then
		gofmt -w "${changed[@]}"
		git add -- "${changed[@]}"
	fi
fi

echo "pre-commit: go test ./..."
go test ./...
