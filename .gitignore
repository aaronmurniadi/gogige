# Camera GenApi dumps (examples/dump-xml)
examples/**/*.xml
examples/**/*.log
examples/**/*.jpg

# Ignore binaries or artifacts genereated
# from running `go build .` or `go run .`
examples/*/*
!examples/*/go.mod
!examples/*/go.sum
!examples/*/main.go
!examples/*/index.html
cmd/gogige-discover/gogige-discover
cmd/gogige-stream/gogige-stream

